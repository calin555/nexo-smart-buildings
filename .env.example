# Vercel / application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — URL and anonymous key are browser-safe; service role stays server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase PostgreSQL: pooled runtime URL and direct migration URL.
DATABASE_URL=
DIRECT_URL=

# Analiza vizuală a planurilor — exclusiv server-side. Lăsați cheia goală pentru fallback manual.
OPENAI_API_KEY=
PLAN_ANALYSIS_MODEL=gpt-5.6
